# FusionSolar-Anbindung (optional)
#
# Ohne diese Variablen läuft die App weiterhin mit simulierten Daten. Sobald
# alle drei Pflichtwerte gesetzt sind, versucht das Dashboard bei jedem
# Abruf zuerst FusionSolar und fällt nur bei Fehlern auf die Simulation
# zurück. Details zur Einrichtung: siehe README.md, Abschnitt
# "FusionSolar-Anbindung".
#
# NICHT diese Datei mit echten Werten befüllen und committen – lokal in
# `.env.local` eintragen (von Git ignoriert) bzw. als Secret in der
# Cursor-Dashboard-Umgebung hinterlegen.

# Basis-URL deiner FusionSolar-Region, OHNE Pfad und OHNE Slash am Ende.
# Beispiele: https://region01eu5.fusionsolar.huawei.com (Europa),
# https://intl.fusionsolar.huawei.com (International)
FUSIONSOLAR_BASE_URL=

# Benutzername des dedizierten Northbound-API-Kontos (NICHT dein normales
# FusionSolar-Portal-Login). Wird im FusionSolar-Portal unter
# "Systemverwaltung > Nordkanal (Northbound)-API-Konten" angelegt.
FUSIONSOLAR_USERNAME=

# Passwort des Northbound-API-Kontos. Huawei nennt dieses Feld "systemCode".
FUSIONSOLAR_SYSTEM_CODE=

# Optional: feste Anlagen-ID (plantCode), falls dein Konto mehrere Anlagen
# verwaltet und eine bestimmte angezeigt werden soll. Ohne diesen Wert wird
# automatisch die erste Anlage des Kontos verwendet.
FUSIONSOLAR_STATION_CODE=

# whatwatt Go-Anbindung per MQTT (optional)
#
# Ergänzt (überschreibt nicht ersetzt) die Netzbezug-/Einspeisungswerte aus
# FusionSolar/Simulation durch Live-Messwerte eines whatwatt Go
# Smart-Meter-Adapters. Läuft über einen MQTT-Broker im Internet, an den
# sich sowohl das Gerät (ausgehend, veröffentlichend) als auch diese App
# (abonnierend) verbinden – funktioniert daher auch, wenn die App
# cloud-gehostet ist und nicht im selben lokalen Netzwerk wie das Gerät
# läuft. Siehe README.md, Abschnitt "whatwatt Go-Anbindung", für die
# Einrichtung von Broker, Geräte-Konfiguration und Payload-Template. Ohne
# diese Variablen bleiben die Netzwerte der Hauptquelle unverändert.

# Broker-URL inkl. Protokoll und Port, z. B.
# mqtts://<cluster-id>.s1.eu.hivemq.cloud:8883 (HiveMQ Cloud, TLS).
WHATWATT_MQTT_URL=

# Zugangsdaten für den Broker (bei HiveMQ Cloud: selbst angelegter Nutzer).
WHATWATT_MQTT_USERNAME=
WHATWATT_MQTT_PASSWORD=

# Topic, auf das das whatwatt Go seine Werte veröffentlicht – muss exakt mit
# dem im Gerät (WebUI → MQTT → Publish Topic) eingetragenen Wert
# übereinstimmen, z. B. PVDash.
WHATWATT_MQTT_TOPIC=

# Stromkonto-Startstand in kWh (optional, Standard: 516).
# Beim ersten whatwatt-Messwert wird dieser Stand an die aktuellen
# Zählerstände angeheftet; danach +/- Netto-Veränderungen (Einspeisung − Bezug).
STROMKONTO_BALANCE_KWH=

# Standort für Sonnenauf-/-untergang & Sonnenstunden-Prognose (optional)
#
# Standard in der App ist Bätterkinden (47.1316, 7.5382). Nutzer können den
# Standort zusätzlich in den Einstellungen anpassen (localStorage). Diese
# Variablen überschreiben den Code-Standard beim Deployment, solange der
# Nutzer keinen eigenen Standort gespeichert hat. NEXT_PUBLIC_ = im Browser
# sichtbar, nur Koordinaten, keine Geheimnisse.
NEXT_PUBLIC_SITE_LATITUDE=
NEXT_PUBLIC_SITE_LONGITUDE=

# forecast.solar Tagesertrags-Prognose (optional)
# URL: /estimate/47.13/7.54/11/180/30.34 (Standort, Neigung 11°, Azimut 180, 30.34 kWp)
# FORECAST_SOLAR_PEAK_KWP=30.34
